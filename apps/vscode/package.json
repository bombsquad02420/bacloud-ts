{
  "name": "bacloud-vscode",
  "displayName": "Ballistica Cloud",
  "version": "0.0.1",
  "private": true,
  "description": "Clone and pull Ballistica cloud workspaces.",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/bombsquad02420/bacloud-ts/tree/main/apps/vscode#readme",
  "bugs": {
    "url": "https://github.com/bombsquad02420/bacloud-ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bombsquad02420/bacloud-ts.git",
    "directory": "apps/vscode"
  },
  "publisher": "aryan02420",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "package": "vp run build && vsce package --no-dependencies --out bacloud-vscode.vsix"
  },
  "devDependencies": {
    "@bacloud/sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "~1.105.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ballistica",
          "title": "Ballistica",
          "icon": "media/bomb.svg"
        }
      ]
    },
    "views": {
      "ballistica": [
        {
          "id": "bacloud.current",
          "name": "Current Workspace"
        },
        {
          "id": "bacloud.localChanges",
          "name": "Local Changes",
          "when": "bacloud.inCheckout"
        },
        {
          "id": "bacloud.changes",
          "name": "Incoming Changes",
          "when": "bacloud.pullStaged"
        },
        {
          "id": "bacloud.workspaces",
          "name": "Cloud Workspaces"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bacloud.workspaces",
        "contents": "Sign in to Ballistica to see your cloud workspaces.\n[Sign in](command:bacloud.signIn)",
        "when": "!bacloud.signedIn"
      },
      {
        "view": "bacloud.current",
        "contents": "No open folder is a Ballistica cloud workspace.\n[Clone a Workspace](command:bacloud.clone)",
        "when": "bacloud.signedIn && !bacloud.inCheckout"
      },
      {
        "view": "bacloud.current",
        "contents": "No open folder is a Ballistica cloud workspace. Sign in to clone one.",
        "when": "!bacloud.signedIn && !bacloud.inCheckout"
      },
      {
        "view": "bacloud.localChanges",
        "contents": "No local changes since the last sync.",
        "when": "!bacloud.hasLocalChanges"
      }
    ],
    "commands": [
      {
        "command": "bacloud.signIn",
        "title": "Sign In",
        "category": "Ballistica"
      },
      {
        "command": "bacloud.signOut",
        "title": "Sign Out",
        "category": "Ballistica",
        "icon": "$(sign-out)"
      },
      {
        "command": "bacloud.refreshWorkspaces",
        "title": "Refresh Cloud Workspaces",
        "category": "Ballistica",
        "icon": "$(refresh)"
      },
      {
        "command": "bacloud.showLog",
        "title": "Show Log",
        "category": "Ballistica"
      },
      {
        "command": "bacloud.clone",
        "title": "Clone Cloud Workspace…",
        "category": "Ballistica",
        "icon": "$(repo-clone)"
      },
      {
        "command": "bacloud.showPanel",
        "title": "Show Ballistica Panel",
        "category": "Ballistica"
      },
      {
        "command": "bacloud.pull",
        "title": "Pull",
        "category": "Ballistica",
        "icon": "$(cloud-download)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "bacloud.push",
        "title": "Push",
        "category": "Ballistica",
        "icon": "$(cloud-upload)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "bacloud.openChange",
        "title": "Compare with Cloud",
        "category": "Ballistica"
      },
      {
        "command": "bacloud.takeCloud",
        "title": "Take Cloud Version",
        "category": "Ballistica",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bacloud.keepLocal",
        "title": "Keep Local Version (Mark Resolved)",
        "category": "Ballistica",
        "icon": "$(check)"
      },
      {
        "command": "bacloud.applyAllIncoming",
        "title": "Apply All Incoming",
        "category": "Ballistica",
        "icon": "$(check-all)"
      },
      {
        "command": "bacloud.discardPull",
        "title": "Discard Pull",
        "category": "Ballistica",
        "icon": "$(discard)"
      },
      {
        "command": "bacloud.mergeConflict",
        "title": "Merge in Merge Editor",
        "category": "Ballistica",
        "icon": "$(git-merge)"
      },
      {
        "command": "bacloud.openLocalChange",
        "title": "Compare with Last Sync",
        "category": "Ballistica"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bacloud.refreshWorkspaces",
          "when": "view == bacloud.workspaces && bacloud.signedIn",
          "group": "navigation"
        },
        {
          "command": "bacloud.signOut",
          "when": "view == bacloud.workspaces && bacloud.signedIn",
          "group": "navigation@9"
        },
        {
          "command": "bacloud.applyAllIncoming",
          "when": "view == bacloud.changes",
          "group": "navigation@1"
        },
        {
          "command": "bacloud.discardPull",
          "when": "view == bacloud.changes",
          "group": "navigation@2"
        },
        {
          "command": "bacloud.push",
          "when": "view == bacloud.localChanges && bacloud.hasLocalChanges",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bacloud.signOut",
          "when": "bacloud.signedIn"
        },
        {
          "command": "bacloud.refreshWorkspaces",
          "when": "bacloud.signedIn"
        },
        {
          "command": "bacloud.clone",
          "when": "bacloud.signedIn"
        },
        {
          "command": "bacloud.pull",
          "when": "bacloud.inCheckout && bacloud.signedIn"
        },
        {
          "command": "bacloud.applyAllIncoming",
          "when": "bacloud.pullStaged"
        },
        {
          "command": "bacloud.discardPull",
          "when": "bacloud.pullStaged"
        },
        {
          "command": "bacloud.openChange",
          "when": "false"
        },
        {
          "command": "bacloud.takeCloud",
          "when": "false"
        },
        {
          "command": "bacloud.keepLocal",
          "when": "false"
        },
        {
          "command": "bacloud.push",
          "when": "bacloud.inCheckout && bacloud.signedIn"
        },
        {
          "command": "bacloud.mergeConflict",
          "when": "false"
        },
        {
          "command": "bacloud.openLocalChange",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "bacloud.clone",
          "when": "view == bacloud.workspaces && viewItem == workspace",
          "group": "inline"
        },
        {
          "command": "bacloud.clone",
          "when": "view == bacloud.workspaces && viewItem == workspace",
          "group": "1_clone"
        },
        {
          "command": "bacloud.takeCloud",
          "when": "view == bacloud.changes && viewItem =~ /^(incoming|conflict)/",
          "group": "inline@2"
        },
        {
          "command": "bacloud.keepLocal",
          "when": "view == bacloud.changes && viewItem =~ /^conflict/",
          "group": "inline@3"
        },
        {
          "command": "bacloud.pull",
          "when": "view == bacloud.current && viewItem == checkout",
          "group": "inline"
        },
        {
          "command": "bacloud.push",
          "when": "view == bacloud.current && viewItem == checkout",
          "group": "inline"
        },
        {
          "command": "bacloud.mergeConflict",
          "when": "view == bacloud.changes && viewItem == conflict-merge",
          "group": "inline@1"
        }
      ],
      "scm/title": [
        {
          "command": "bacloud.pull",
          "when": "scmProvider == ballistica",
          "group": "navigation@1"
        },
        {
          "command": "bacloud.push",
          "when": "scmProvider == ballistica",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Ballistica Cloud",
      "properties": {
        "bacloud.fleet": {
          "type": "string",
          "enum": [
            "prod",
            "test",
            "dev"
          ],
          "default": "prod",
          "description": "Which Ballistica cloud fleet to use."
        },
        "bacloud.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log session diagnostics to the Ballistica output channel."
        }
      }
    },
    "authentication": [
      {
        "id": "ballistica",
        "label": "Ballistica"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pulling writes files, so it is only available in trusted folders."
    }
  }
}
